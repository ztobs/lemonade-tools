# Example API keys for llama-server
# Copy this file to api-keys and replace with your own keys
# Format: one key per line
# The server reads this file with --api-key-file flag

# Example hex key (64-char hex)
a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# Example prefixed key
sk-lm-abcd1234:YourSecretKeyHere
